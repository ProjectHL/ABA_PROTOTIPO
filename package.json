    "local:stop": "powershell -NoProfile -File scripts/local/stop.ps1",
    "local:fixtures": "powershell -NoProfile -File scripts/local/fixtures.ps1",
    "local:switch-role": "powershell -NoProfile -File scripts/local/switch-role.ps1",
    "test": "vitest run",
    "test:db": "vitest run tests/database",
    "test:e2e": "playwright test",
    "test:e2e:local-auth": "node scripts/run-local-auth-e2e.mjs",
