{
  "name": "aba-prototipo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "local:install-node": "powershell -NoProfile -File scripts/local/install-node.ps1",
    "local:configure": "powershell -NoProfile -File scripts/local/configure.ps1",
    "local:start": "powershell -NoProfile -File scripts/local/start.ps1",
    "local:status": "powershell -NoProfile -File scripts/local/status.ps1",
