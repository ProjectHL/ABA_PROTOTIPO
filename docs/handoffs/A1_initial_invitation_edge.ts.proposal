// Proposal: root replaces invite-clinic-member AFTER reviewing/applying delta38.
// Account creation is mail-free; ALL initial SMTP goes through durable resend worker.
import 'jsr:@supabase/functions-js/edge-runtime.d.ts';
import { createClient } from 'npm:@supabase/supabase-js@2.114.0';
const uuid=(v:unknown):v is string=>typeof v==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(v);
const allowed=new Set((Deno.env.get('ABA_ALLOWED_ORIGINS')??'http://localhost:3000,http://127.0.0.1:3000').split(',').map(s=>s.trim()).filter(Boolean));
const boundedFetch:typeof fetch=(input,init)=>fetch(input,{...init,signal:AbortSignal.timeout(15_000)});
type MembershipReceipt={operation_id:string;status:'pending'|'completed';user_id:string|null;role:string};
function membership(raw:unknown,role:string):MembershipReceipt {
  if(!raw||typeof raw!=='object')throw new Error('invalid_receipt');
  const r=raw as Record<string,unknown>;
  if(!uuid(r.operation_id)||!['pending','completed'].includes(String(r.status))||r.role!==role||
    (r.status==='completed'&&!uuid(r.user_id))||(r.status==='pending'&&r.user_id!==null))throw new Error('invalid_receipt');
  return {operation_id:r.operation_id,status:r.status as MembershipReceipt['status'],user_id:r.user_id as string|null,role};
}
function initialDelivery(raw:unknown,org:string,op:string):Record<string,unknown>{
  if(!raw||typeof raw!=='object')throw new Error('invalid_delivery');const d=raw as Record<string,unknown>;
  if(!uuid(d.deliveryId)||d.organizationId!==org||d.invitationId!==op||d.operationId!==op||d.idempotencyKey!==op||d.payloadVersion!==1||
    !['pending','claimed','sent','failed','unknown'].includes(String(d.state))||!Number.isSafeInteger(d.version)||Number(d.version)<1)throw new Error('invalid_delivery');
  for(const field of ['createdAt','updatedAt'])if(typeof d[field]!=='string'||!Number.isFinite(Date.parse(d[field] as string)))throw new Error('invalid_delivery');
  if(d.expiresAt!==null&&(typeof d.expiresAt!=='string'||!Number.isFinite(Date.parse(d.expiresAt))))throw new Error('invalid_delivery');
  if(d.testRunId!==null&&!uuid(d.testRunId))throw new Error('invalid_delivery');
  if(d.errorCode!==null&&!['already-accepted','auth-rejected','transport-unknown','claim-expired','reservation-expired','operator-observed-mailpit','operator-authorized-possible-duplicate'].includes(String(d.errorCode)))throw new Error('invalid_delivery');
  if(d.confirmationSource!==null&&!['auth','operator-mailpit'].includes(String(d.confirmationSource)))throw new Error('invalid_delivery');
  return {deliveryId:d.deliveryId,organizationId:org,invitationId:op,operationId:op,idempotencyKey:op,payloadVersion:1,
    state:d.state,version:d.version,createdAt:d.createdAt,updatedAt:d.updatedAt,expiresAt:d.expiresAt,errorCode:d.errorCode,confirmationSource:d.confirmationSource,testRunId:d.testRunId};
}
Deno.serve(async(request:Request)=>{
  const origin=request.headers.get('Origin');const headers={'Content-Type':'application/json','Access-Control-Allow-Headers':'authorization, x-client-info, apikey, content-type','Access-Control-Allow-Methods':'POST, OPTIONS',Vary:'Origin',...(origin&&allowed.has(origin)?{'Access-Control-Allow-Origin':origin}:{})};
  const reply=(status:number,body:Record<string,unknown>)=>new Response(JSON.stringify(body),{status,headers});
  if(origin&&!allowed.has(origin))return reply(403,{error:'origin_not_allowed'});
  if(request.method==='OPTIONS')return reply(200,{});if(request.method!=='POST')return reply(405,{error:'method_not_allowed'});
  const authorization=request.headers.get('Authorization');if(!authorization?.startsWith('Bearer '))return reply(401,{error:'authentication_required'});
  let body:Record<string,unknown>;try{body=await request.json();}catch{return reply(400,{error:'invalid_json'});}
  if(!body||typeof body!=='object'||Object.keys(body).some(k=>!['organizationId','operationId','email','role'].includes(k))||!uuid(body.organizationId)||!uuid(body.operationId)||typeof body.email!=='string'||typeof body.role!=='string')return reply(400,{error:'invalid_invitation'});
  const org=body.organizationId;const requested=body.operationId;const email=body.email.trim().toLowerCase();const role=body.role;
  if(email.length>254||!/^\S+@\S+\.\S+$/.test(email)||!['admin','supervisor','therapist'].includes(role))return reply(400,{error:'invalid_invitation'});
  const url=Deno.env.get('SUPABASE_URL')??'';const anon=Deno.env.get('SUPABASE_ANON_KEY')??'';const service=Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')??'';
  if(!url||!anon||!service)return reply(500,{error:'server_configuration_error'});
  const token=authorization.slice(7);
  try {
    const user=createClient(url,anon,{global:{headers:{Authorization:authorization},fetch:boundedFetch},auth:{persistSession:false,autoRefreshToken:false}});
    const identity=await user.auth.getUser(token);if(identity.error||!identity.data.user)return reply(401,{error:'authentication_required'});
    const actor=identity.data.user.id;const current=async()=>{const next=await user.auth.getUser(token);return !next.error&&next.data.user?.id===actor;};
    const begun=await user.rpc('mvp_begin_clinic_invitation',{p_organization_id:org,p_operation_id:requested,p_email:email,p_role:role});
    if(begun.error)return reply(begun.error.code==='42501'?403:begun.error.message.includes('conflict')||begun.error.message.includes('use_resend')?409:500,{error:begun.error.message.includes('use_resend')?'existing_membership_use_resend':begun.error.code==='42501'?'clinic_admin_required':'invitation_not_started'});
    const started=membership(begun.data,role);const canonical=started.operation_id;
    if(!await current())return reply(401,{error:'authentication_required'});
    // Completion first resolves existing Auth without any lookup/enumeration exposed
    // to clients. Missing account is the ONLY condition for mail-free createUser.
    let completed=await user.rpc('mvp_complete_clinic_invitation',{p_organization_id:org,p_operation_id:canonical});
    const worker=createClient(url,service,{global:{fetch:boundedFetch},auth:{persistSession:false,autoRefreshToken:false}});
    if(completed.error?.message.includes('invited_auth_user_not_found')){
      if(!await current())return reply(401,{error:'authentication_required'});
      // Fresh active-admin authorization before privileged account creation.
      const checked=await user.rpc('mvp_begin_clinic_invitation',{p_organization_id:org,p_operation_id:canonical,p_email:email,p_role:role});
      if(checked.error)return reply(403,{error:'clinic_admin_required'});
      membership(checked.data,role);
      // Auth v2.196 adminUserCreate generates a password internally when omitted
      // and does NOT send mail. Never email-confirm or set a known password here.
      const created=await worker.auth.admin.createUser({email,email_confirm:false});
      if(created.error&&created.error.code!=='email_exists')return reply(502,{error:'account_creation_not_confirmed',operationId:canonical,requestedOperationId:requested});
      if(!created.error&&(!uuid(created.data.user?.id)||created.data.user?.email?.toLowerCase()!==email))return reply(502,{error:'account_creation_not_confirmed',operationId:canonical,requestedOperationId:requested});
      if(!await current())return reply(401,{error:'authentication_required'});
      completed=await user.rpc('mvp_complete_clinic_invitation',{p_organization_id:org,p_operation_id:canonical});
    }
    if(completed.error)return reply(completed.error.code==='42501'?403:completed.error.message.includes('conflict')?409:502,{error:completed.error.message.includes('conflict')?'existing_membership_conflict_use_team_management':'membership_not_confirmed',operationId:canonical,requestedOperationId:requested});
    const saved=membership(completed.data,role);if(saved.status!=='completed'||saved.operation_id!==canonical||!saved.user_id)throw new Error('invalid_receipt');
    // Membership is now acknowledged. Subsequent mail errors cannot turn it into
    // "not saved" or cause initial SMTP retry outside the delivery claim.
    const response={operationId:canonical,requestedOperationId:requested,status:'completed',userId:saved.user_id,role,
      invited:false,replayed:started.status==='completed',alreadyAccepted:false,delivery:null as Record<string,unknown>|null,deliveryError:null as string|null};
    if(!await current())return reply(200,{...response,deliveryError:'outcome-not-confirmed'});
    const target=await worker.auth.admin.getUserById(saved.user_id);
    if(target.error||target.data.user?.id!==saved.user_id||target.data.user.email?.toLowerCase()!==email)return reply(200,{...response,deliveryError:'outcome-not-confirmed'});
    if(target.data.user.email_confirmed_at)return reply(200,{...response,alreadyAccepted:true});
    // Internal HTTP calls the SAME reviewed worker with end-user JWT, never actor
    // from the body or service-role pretending auth.uid(). Canonical UUIDs are
    // stable across crashes between membership completion and delivery reserve.
    try {
      const sent=await boundedFetch(new URL('/functions/v1/resend-clinic-invitation',url),{method:'POST',headers:{Authorization:authorization,apikey:anon,'Content-Type':'application/json',...(origin?{Origin:origin}:{})},body:JSON.stringify({organizationId:org,invitationId:canonical,operationId:canonical,idempotencyKey:canonical})});
      if(!sent.ok)return reply(200,{...response,deliveryError:'outcome-not-confirmed'});
      const envelope=await sent.json() as {delivery?:unknown};const receipt=initialDelivery(envelope.delivery,org,canonical);
      return reply(200,{...response,delivery:receipt,invited:receipt.state==='sent'&&receipt.confirmationSource==='auth'});
    }catch{return reply(200,{...response,deliveryError:'outcome-not-confirmed'});}
  }catch{return reply(502,{error:'invitation_outcome_not_confirmed',requestedOperationId:requested});}
});
