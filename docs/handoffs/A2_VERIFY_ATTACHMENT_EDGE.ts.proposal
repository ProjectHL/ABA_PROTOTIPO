// PROPOSAL ONLY — root owns real Edge source/sync. Never deploy this document.
// Required environment: URL/anon for user JWT validation plus a verifier-only
// credential held in Edge secrets. It is never NEXT_PUBLIC or returned to browser.

import { createClient } from 'jsr:@supabase/supabase-js@2';

type RequestBody = { organizationId:string; reservation:Record<string,unknown>; confirmation:Record<string,unknown> };
const signatures:Record<string,number[]>={
  'application/pdf':[0x25,0x50,0x44,0x46,0x2d], 'image/jpeg':[0xff,0xd8,0xff], 'image/png':[0x89,0x50,0x4e,0x47,0x0d,0x0a,0x1a,0x0a],
};
const hex=(bytes:Uint8Array)=>Array.from(bytes,x=>x.toString(16).padStart(2,'0')).join('');

Deno.serve(async (request) => {
  const bearer=request.headers.get('authorization'); if(!bearer?.startsWith('Bearer ')) return Response.json({error:'authentication_required'},{status:401});
  const body=await request.json() as RequestBody;
  // User client validates JWT/active membership/resource through a public READ-ONLY
  // RPC. Verifier client has the restricted secret but does not trust body identity.
  const user=createClient(Deno.env.get('SUPABASE_URL')!,Deno.env.get('SUPABASE_ANON_KEY')!,{global:{headers:{Authorization:bearer}}});
  const {data:{user:actor}}=await user.auth.getUser(); if(!actor) return Response.json({error:'authentication_required'},{status:401});
  const {data:pending,error:pendingError}=await user.rpc('aba_attachment_verification_target_v2',{p_organization_id:body.organizationId,p_reservation:body.reservation,p_confirmation:body.confirmation});
  if(pendingError||!pending) return Response.json({error:'resource_unavailable'},{status:403});
  // pending contains only server-derived bucket/key/expected mime,length/SHA and is
  // bound to actor+reservation+confirmation. It is not supplied by the caller.
  // ABA_ATTACHMENT_VERIFIER_KEY is a dedicated verifier credential, not the
  // project service_role. Its database role has EXECUTE only on the two private
  // verifier RPCs, no table/storage grants, and those RPCs bind actor+org+pending
  // attachment/version/objectKey before a state transition.
  const verifier=createClient(Deno.env.get('SUPABASE_URL')!,Deno.env.get('ABA_ATTACHMENT_VERIFIER_KEY')!);
  const {data:file,error:downloadError}=await verifier.storage.from(pending.bucket).download(pending.objectKey);
  if(downloadError||!file) return Response.json({error:'outcome_unknown'},{status:503});
  const bytes=new Uint8Array(await file.arrayBuffer()); const expected=signatures[pending.mimeType]??[];
  const digest=hex(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)));
  if(bytes.byteLength!==pending.byteLength||!expected.every((v,i)=>bytes[i]===v)||digest!==pending.sha256) {
    await verifier.rpc('aba_attachment_mark_verification_failed_v2',{p_organization_id:body.organizationId,p_reservation:body.reservation,p_reason:'bytes_mismatch'});
    return Response.json({error:'validation_failed'},{status:422});
  }
  // Idempotent private routine locks/replays confirmation identity; it returns the
  // exact envelope. A timeout after this point is unknown; caller repeats the same
  // confirmation and gets its durable receipt, never a second available version.
  const {data,error:confirmError}=await verifier.rpc('aba_attachment_confirm_verified_v2',{p_organization_id:body.organizationId,p_reservation:body.reservation,p_confirmation:body.confirmation,p_verified_sha256:digest});
  if(confirmError||!data) return Response.json({error:'outcome_unknown'},{status:503});
  return Response.json(data,{status:200});
});
