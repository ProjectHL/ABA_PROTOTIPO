// Root integrates as supabase/functions/resend-clinic-invitation/index.ts.
// No writes by A1 outside owned files; this is a reviewed implementation proposal.
import 'jsr:@supabase/functions-js/edge-runtime.d.ts';
import { createClient } from 'npm:@supabase/supabase-js@2.114.0';

const uuid=(value:unknown):value is string=>typeof value==='string'&&/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(value);
const states=['pending','claimed','sent','failed','unknown'];
const safeErrors=['already-accepted','auth-rejected','transport-unknown','claim-expired','operator-observed-mailpit','operator-authorized-possible-duplicate'];
type Delivery={deliveryId:string;organizationId:string;invitationId:string;operationId:string;idempotencyKey:string;payloadVersion:1;state:string;version:number;createdAt:string;updatedAt:string;expiresAt:string|null;errorCode:string|null;confirmationSource:string|null;testRunId:string|null};
function delivery(value:unknown):Delivery {
  if(!value||typeof value!=='object')throw new Error('invalid_delivery');const d=value as Record<string,unknown>;
  for(const field of ['deliveryId','organizationId','invitationId','operationId','idempotencyKey'])if(!uuid(d[field]))throw new Error('invalid_delivery');
  if(d.payloadVersion!==1||!states.includes(String(d.state))||typeof d.version!=='number'||!Number.isSafeInteger(d.version)||d.version<1)throw new Error('invalid_delivery');
  for(const field of ['createdAt','updatedAt'])if(typeof d[field]!=='string'||!Number.isFinite(Date.parse(d[field] as string)))throw new Error('invalid_delivery');
  if(d.errorCode!==null&&!safeErrors.includes(String(d.errorCode)))throw new Error('invalid_delivery');
  if(d.confirmationSource!==null&&!['auth','operator-mailpit'].includes(String(d.confirmationSource)))throw new Error('invalid_delivery');
  if(d.testRunId!==null&&!uuid(d.testRunId))throw new Error('invalid_delivery');
  if(d.expiresAt!==null&&(typeof d.expiresAt!=='string'||!Number.isFinite(Date.parse(d.expiresAt))))throw new Error('invalid_delivery');
  // Build explicitly: no claim token, link, password, email or service key can leak.
  return {deliveryId:d.deliveryId as string,organizationId:d.organizationId as string,invitationId:d.invitationId as string,
    operationId:d.operationId as string,idempotencyKey:d.idempotencyKey as string,payloadVersion:1,state:d.state as string,
    version:d.version,createdAt:d.createdAt as string,updatedAt:d.updatedAt as string,expiresAt:d.expiresAt as string|null,
    errorCode:d.errorCode as string|null,confirmationSource:d.confirmationSource as string|null,testRunId:d.testRunId as string|null};
}
const allowedOrigins=new Set((Deno.env.get('ABA_ALLOWED_ORIGINS')??'http://localhost:3000,http://127.0.0.1:3000').split(',').map(s=>s.trim()).filter(Boolean));
// Bound all internal requests. HTTP5xx/timeout after Auth claim is unknown, not failed.
const boundedFetch:typeof fetch=(input,init)=>fetch(input,{...init,signal:AbortSignal.timeout(15_000)});
Deno.serve(async(request:Request)=>{
  const origin=request.headers.get('Origin');
  const headers={...(origin&&allowedOrigins.has(origin)?{'Access-Control-Allow-Origin':origin}:{}),'Access-Control-Allow-Headers':'authorization, x-client-info, apikey, content-type','Content-Type':'application/json',Vary:'Origin'};
  const reply=(status:number,body:Record<string,unknown>)=>new Response(JSON.stringify(body),{status,headers});
  if(origin&&!allowedOrigins.has(origin))return reply(403,{error:'origin_not_allowed'});
  if(request.method==='OPTIONS')return reply(200,{});
  if(request.method!=='POST')return reply(405,{error:'method_not_allowed'});
  const authorization=request.headers.get('Authorization');if(!authorization?.startsWith('Bearer '))return reply(401,{error:'authentication_required'});
  const url=Deno.env.get('SUPABASE_URL')??'';const anon=Deno.env.get('SUPABASE_ANON_KEY')??'';const service=Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')??'';
  if(!url||!anon||!service)return reply(500,{error:'server_configuration_error'});
  const token=authorization.slice('Bearer '.length);
  try {
    const body=await request.json() as Record<string,unknown>;
    if(!body||typeof body!=='object'||Object.keys(body).some(k=>!['organizationId','invitationId','operationId','idempotencyKey'].includes(k))
      ||![body.organizationId,body.invitationId,body.operationId,body.idempotencyKey].every(uuid))return reply(400,{error:'invalid_delivery_command'});
    const org=body.organizationId as string;const invitation=body.invitationId as string;const operation=body.operationId as string;const key=body.idempotencyKey as string;
    const check=(d:Delivery)=>{if(d.organizationId!==org||d.invitationId!==invitation||d.operationId!==operation||d.idempotencyKey!==key)throw new Error('delivery_identity_mismatch');return d;};
    const user=createClient(url,anon,{global:{headers:{Authorization:authorization},fetch:boundedFetch},auth:{persistSession:false,autoRefreshToken:false}});
    const identity=await user.auth.getUser(token);if(identity.error||!identity.data.user)return reply(401,{error:'authentication_required'});
    const actor=identity.data.user.id;
    const current=async()=>{const next=await user.auth.getUser(token);return !next.error&&next.data.user?.id===actor;};
    const reserved=await user.rpc('aba_reserve_team_invitation_delivery',{p_org:org,p_invite:invitation,p_operation:operation,p_key:key});
    if(reserved.error){
      const message=reserved.error.message;const code=reserved.error.code;
      const error=message.includes('already_accepted')?'invitation_already_accepted':message.includes('idempotency_conflict')?'delivery_idempotency_conflict':message.includes('requires_resolution')?'delivery_requires_resolution':message.includes('target_changed')?'invitation_target_changed':'delivery_not_reserved';
      return reply(code==='42501'?403:error==='delivery_not_reserved'?500:409,{error});
    }
    const pending=check(delivery(reserved.data));
    if(!await current())return reply(401,{error:'authentication_required'});
    const worker=createClient(url,service,{global:{fetch:boundedFetch},auth:{persistSession:false,autoRefreshToken:false}});
    const claimed=await worker.rpc('aba_claim_team_invitation_delivery',{p_org:org,p_delivery:pending.deliveryId,p_actor:actor});
    if(claimed.error)return reply(claimed.error.code==='42501'?403:502,{error:'delivery_claim_not_confirmed'});
    const claim=claimed.data as Record<string,unknown>;const snapshot=check(delivery(claim?.delivery));
    if(claim.send===false)return reply(200,{delivery:snapshot});
    if(claim.send!==true||!uuid(claim.claimToken)||!uuid(claim.subjectUserId)||typeof claim.recipient!=='string'||!/^\S+@\S+\.\S+$/.test(claim.recipient))throw new Error('invalid_worker_claim');
    const recipient=claim.recipient;const subject=claim.subjectUserId;const claimToken=claim.claimToken;
    let outcome:'sent'|'failed'|'unknown'='unknown';let safeError:string|null='transport-unknown';
    const target=await worker.auth.admin.getUserById(subject);
    if(target.error||target.data.user?.id!==subject||target.data.user.email?.toLowerCase()!==recipient) {outcome='failed';safeError='auth-rejected';}
    else if(target.data.user.email_confirmed_at) {outcome='failed';safeError='already-accepted';}
    else {
      if(!await current())return reply(401,{error:'authentication_required'});
      const site=new URL(origin??Deno.env.get('ABA_SITE_URL')??'http://localhost:3000');
      if(!allowedOrigins.has(site.origin)||site.username||site.password||site.pathname!=='/'||site.search||site.hash)throw new Error('invalid_site_configuration');
      // Current local Auth v2.196.0 resends invite ONLY for existing unconfirmed user.
      // Never use password recovery for a third party or accept arbitrary email/redirect.
      try {
        const sent=await worker.auth.admin.inviteUserByEmail(recipient,{redirectTo:new URL('/auth/confirm?next=/reset-password',site).href});
        if(!sent.error&&sent.data.user?.id===subject&&sent.data.user.email?.toLowerCase()===recipient){outcome='sent';safeError=null;}
        else if(sent.error){
          const status=sent.error.status;const code=sent.error.code;
          if(code==='email_exists'){outcome='failed';safeError='already-accepted';}
          else if(status&&[400,401,403,404,409,422,429].includes(status)){outcome='failed';safeError='auth-rejected';}
          // 5xx/408/network or malformed success remains unknown: SMTP may have accepted.
        }
      } catch { /* retain unknown; no automatic resend */ }
    }
    if(!await current())return reply(401,{error:'authentication_required'});
    const finished=await worker.rpc('aba_finish_team_invitation_delivery',{p_org:org,p_delivery:pending.deliveryId,p_actor:actor,p_claim:claimToken,p_outcome:outcome,p_error:safeError});
    if(finished.error)return reply(finished.error.code==='42501'?403:502,{error:'delivery_outcome_not_confirmed'});
    return reply(200,{delivery:check(delivery(finished.data))});
  } catch {
    // No raw SDK error/stack/links. Claimed records expire durably unknown on status/list.
    return reply(502,{error:'delivery_outcome_not_confirmed'});
  }
});
