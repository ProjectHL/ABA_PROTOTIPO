{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".aba.local/qa/next-build/types/**/*.ts",
    ".aba.local/qa/next-build/dev/types/**/*.ts",
    ".aba.local/qa/next-build-results/types/**/*.ts",
    ".aba.local/qa/next-build-results/dev/types/**/*.ts",
    ".aba.local/qa/next-webpack-dev/types/**/*.ts",
    ".aba.local/qa/next-webpack-dev/dev/types/**/*.ts",
    ".aba.local/qa/next-build-route/types/**/*.ts",
    ".aba.local/qa/next-build-route/dev/types/**/*.ts",
    ".aba.local/qa/next-build-attachment-route/types/**/*.ts",
    ".aba.local/qa/next-build-attachment-route/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v6-external/types/**/*.ts",
    ".aba.local/qa/next-build-v6-external/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v7-designer/types/**/*.ts",
    ".aba.local/qa/next-build-v7-designer/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v8-contacts/types/**/*.ts",
    ".aba.local/qa/next-build-v8-contacts/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v9-interval/types/**/*.ts",
    ".aba.local/qa/next-build-v9-interval/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v10-percentage/types/**/*.ts",
    ".aba.local/qa/next-build-v10-percentage/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v11-support/types/**/*.ts",
    ".aba.local/qa/next-build-v11-support/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v12-dashboard/types/**/*.ts",
    ".aba.local/qa/next-build-v12-dashboard/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v13-shared/types/**/*.ts",
    ".aba.local/qa/next-build-v13-shared/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v14-history/types/**/*.ts",
    ".aba.local/qa/next-build-v14-history/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v15-medication/types/**/*.ts",
    ".aba.local/qa/next-build-v15-medication/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v16-medication/types/**/*.ts",
    ".aba.local/qa/next-build-v16-medication/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v17-clinical-header/types/**/*.ts",
    ".aba.local/qa/next-build-v17-clinical-header/dev/types/**/*.ts",
    ".aba.local/qa/next-build-v18-clinical-header/types/**/*.ts",
    ".aba.local/qa/next-build-v18-clinical-header/dev/types/**/*.ts",
