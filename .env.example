# PostgreSQL
DATABASE_URL=postgresql://aba:change-me@127.0.0.1:5432/aba
DATABASE_POOL_MAX=10

# Auth sessions and one-time links. At least 32 bytes.
# Generate once with: openssl rand -base64 48
AUTH_SECRET=replace_with_at_least_32_bytes

# Public origin used in invitation and recovery links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMTP for invitations and password recovery. If omitted, development logs the
# message instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ABA Clínico <no-reply@aba.local>

# Private file storage (clinical attachments and profile avatars).
STORAGE_ROOT=./.runtime.local/storage

# Only for synthetic-data runs: UUID that tags data for controlled cleanup.
ABA_TEST_RUN_ID=
