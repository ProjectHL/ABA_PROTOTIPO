# Generate with: NEXT_PUBLIC_APP_URL=https://your-domain npm run env:init
# Never commit the generated infra/.env.

# --- Application image -------------------------------------------------------
# Immutable release id (full Git SHA). `latest` only for a throwaway local run.
ABA_IMAGE_TAG=latest

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=aba
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aba
DATABASE_POOL_MAX=10

# --- Authentication ----------------------------------------------------------
# At least 32 random bytes. Generate once: openssl rand -base64 48
AUTH_SECRET=change-me-with-at-least-32-bytes

# Public origin used in invitation and recovery links.
NEXT_PUBLIC_APP_URL=https://app.example.com

# BuildKit secret for Next.js Server Actions. Base64 of 32 bytes.
# Generate once: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Email -------------------------------------------------------------------
# Required in production: invitations and recovery links are delivered by SMTP.
# When SMTP_HOST is empty outside production the message is logged instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ABA Clínico <no-reply@example.com>

# --- Optional ----------------------------------------------------------------
# UUID tag for controlled cleanup of synthetic data. Leave empty otherwise.
ABA_TEST_RUN_ID=
