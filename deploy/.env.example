APP_HOST=aba.example.com
ABA_IMAGE_TAG=replace-with-git-sha
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Se entrega al build mediante BuildKit secret; no se guarda como ARG ni capa de imagen.
# Base64 de 32 bytes, generado una vez y conservado entre builds/despliegues.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_stable_base64_key
# Dejar vacío en la PoC clínica. Usar UUID solamente en ensayos dummy.
ABA_TEST_RUN_ID=
